  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Skip auto-refresh for auth endpoints to avoid loops",
          "const skipPaths = ['/api/login', '/api/register', '/api/refresh'];",
          "const url = pm.request.url.toString();",
          "if (skipPaths.some(path => url.includes(path))) return;",
          "",
          "const jwt = pm.environment.get('jwt');",
          "if (!jwt) return;",
          "",
          "// Decode JWT payload to read expiration",
          "function parseJwt(token) {",
          "    try {",
          "        const base64Url = token.split('.')[1];",
          "        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
          "        const jsonPayload = decodeURIComponent(",
          "            atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('')",
          "        );",
          "        return JSON.parse(jsonPayload);",
          "    } catch (e) {",
          "        return null;",
          "    }",
          "}",
          "",
          "const payload = parseJwt(jwt);",
          "if (!payload || !payload.exp) return;",
          "",
          "const now = Math.floor(Date.now() / 1000);",
          "",
          "if (now >= payload.exp) {",
          "    pm.sendRequest({",
          "        url: 'http://127.0.0.1:8000/api/refresh',",
          "        method: 'POST',",
          "        header: {",
          "            'Authorization': 'Bearer ' + jwt,",
          "            'Accept': 'application/json'",
          "        }",
          "    }, function(err, res) {",
          "        if (err) {",
          "            console.error('[JWT Refresh] Request error:', err);",
          "            return;",
          "        }",
          "",
          "        console.log('[JWT Refresh] Status:', res.code);",
          "        console.log('[JWT Refresh] Body:', res.text());",
          "",
          "        if (res.code >= 200 && res.code < 300) {",
          "            const json = res.json();",
          "            const newToken = json.access_token",
          "                || json.token",
          "                || json.jwt",
          "                || (json.data && (json.data.access_token || json.data.token || json.data.jwt))",
          "                || access_token;",
          "",
          "            if (newToken) {",
          "                pm.environment.set('jwt', newToken);",
          "                console.log('[JWT Refresh] Token updated successfully');",
          "            } else {",
          "                console.warn('[JWT Refresh] No token found in response. Available keys:', Object.keys(json).join(', '));",
          "            }",
          "        } else {",
          "            console.warn('[JWT Refresh] Failed with status:', res.code);",
          "        }",
          "    });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ]
}